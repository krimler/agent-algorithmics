% --------------------
% Formatting discipline
% --------------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlist[itemize]{leftmargin=1.5em}
\setlist[enumerate]{leftmargin=1.5em}

% --------------------
% Theorem environments
% --------------------
\newtheorem{definition}{Definition}[chapter]
\newtheorem{lemma}{Lemma}[chapter]
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{proposition}{Proposition}[chapter]
\newtheorem{claim}{Claim}[chapter]

% --------------------
% Custom paragraph headers (Eva-style)
% --------------------
\newcommand{\problem}{\paragraph{Problem.}}
\newcommand{\model}{\paragraph{Model.}}
\newcommand{\mechanism}{\paragraph{Mechanism.}}
\newcommand{\consequence}{\paragraph{Consequence.}}
\newcommand{\evaluation}{\paragraph{Evaluation Hook.}}

