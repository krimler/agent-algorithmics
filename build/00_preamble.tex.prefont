\DeclareUnicodeCharacter{2510}{+}
\DeclareUnicodeCharacter{25BA}{>}
\DeclareUnicodeCharacter{25B6}{>}

\DeclareUnicodeCharacter{221A}{$\sqrt{}$}
\DeclareUnicodeCharacter{2229}{$\cap$}
\DeclareUnicodeCharacter{2286}{$\subseteq$}
